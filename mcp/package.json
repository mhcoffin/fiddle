{
  "name": "fiddle-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --banner:js=\"#!/usr/bin/env node\" --outfile=dist/fiddle-mcp.mjs && esbuild src/fiddle-client.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/fiddle-client.mjs",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:ci": "pnpm run check && pnpm run build && pnpm test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "26.6.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
