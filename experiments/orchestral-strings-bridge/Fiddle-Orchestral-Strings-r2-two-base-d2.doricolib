<kScoreLibrary>
  <fileVersion>1.1438</fileVersion>
  <expressionMapDefinitions>
    <entities array="true">
      <ExpressionMapDefinition>
        <name>Fiddle Strings r2 - TWO BASE d2 - PROBE ONLY</name>
        <entityID>xmap.user.Fiddle.OrchestralStrings.Diagnostic.TwoBase.d2</entityID>
        <parentEntityID />
        <inheritanceMask>0</inheritanceMask>
        <creator>Fiddle</creator>
        <description>DIAGNOSTIC d2 ONLY: silent Fiddle MIDI Probe, not production Fiddle. Retains frozen r2 Natural bases 2 (Medium) and 4 (&gt;Long), including their original conditions and actions; omits the other 23 bases. All add-ons, On/Off, Init and mutex data unchanged. No base covers VeryShort, Short or Long; use only the documented shared-overlap fixture. Source SHA256: 31e8826434ecda621459343e95725ca31e1c495053f309e9fc70f4c5b0b92647</description>
        <version>1</version>
        <pluginNames />
        <autoMutualExclusion>false</autoMutualExclusion>
        <allowMultipleNotesAtSamePitch>true</allowMultipleNotesAtSamePitch>
        <applyStageTemplateSettings>false</applyStageTemplateSettings>
        <pitchBendRange>2</pitchBendRange>
        <microtonalPlaybackMethod>kAuto</microtonalPlaybackMethod>
